diff --git a/ios/Sources/VRizationCore/EyeAlignment.swift b/ios/Sources/VRizationCore/EyeAlignment.swift
new file mode 100644
index 0000000..06ea79a
--- /dev/null
+++ b/ios/Sources/VRizationCore/EyeAlignment.swift
@@ -0,0 +1,37 @@
+import Foundation
+
+/// Local optical corrections only: never sent to the Windows host or pose stream.
+/// Coordinates use the per-eye viewport: positive X is right, positive Y is up.
+public struct EyeAlignment: Codable, Equatable {
+    public var leftX: Double = 0
+    public var leftY: Double = 0
+    public var rightX: Double = 0
+    public var rightY: Double = 0
+    public init() {}
+    public func validated() throws -> EyeAlignment {
+        guard [leftX, leftY, rightX, rightY].allSatisfy({ $0.isFinite && abs($0) <= 0.3 }) else {
+            throw VRCoreError.invalid("Invalid local eye alignment")
+        }
+        return self
+    }
+    public func center(base: FitPoint, eye: Int) -> FitPoint {
+        FitPoint(x: base.x + (eye == 0 ? leftX : rightX),
+                 y: base.y + (eye == 0 ? leftY : rightY))
+    }
+}
+
+public final class EyeAlignmentStore {
+    public static let key = "localEyeAlignment.v1"
+    private let defaults: UserDefaults
+    public init(defaults: UserDefaults = .standard) { self.defaults = defaults }
+    public func load() -> EyeAlignment {
+        guard let data = defaults.data(forKey: Self.key),
+              let profile = try? JSONDecoder().decode(EyeAlignment.self, from: data),
+              let valid = try? profile.validated() else { return EyeAlignment() }
+        return valid
+    }
+    public func save(_ profile: EyeAlignment) throws {
+        defaults.set(try JSONEncoder().encode(profile.validated()), forKey: Self.key)
+    }
+    public func reset() { defaults.removeObject(forKey: Self.key) }
+}
