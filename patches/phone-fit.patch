diff --git a/ios/Tests/VRizationCoreTests/EyeAlignmentTests.swift b/ios/Tests/VRizationCoreTests/EyeAlignmentTests.swift
new file mode 100644
index 0000000..b383e31
--- /dev/null
+++ b/ios/Tests/VRizationCoreTests/EyeAlignmentTests.swift
@@ -0,0 +1,39 @@
+import XCTest
+@testable import VRizationCore
+
+final class EyeAlignmentTests: XCTestCase {
+    func testIndependentCorrectionsPreserveOtherEyeAndCommonPlacement() {
+        var profile = EyeAlignment(); profile.rightY = 0.075; profile.leftX = -0.02
+        let base = FitPoint(x: 0.1, y: -0.05)
+        let left = profile.center(base: base, eye: 0)
+        let right = profile.center(base: base, eye: 1)
+        XCTAssertEqual(left.x, 0.08, accuracy: 0.00001)
+        XCTAssertEqual(left.y, -0.05, accuracy: 0.00001)
+        XCTAssertEqual(right.x, 0.1, accuracy: 0.00001)
+        XCTAssertEqual(right.y, 0.025, accuracy: 0.00001)
+    }
+    func testPersistenceResetAndCorruptProfileFallbackDoNotChangeHostProfile() throws {
+        let name = "org.vrization.alignment-test.\(UUID().uuidString)"
+        let defaults = UserDefaults(suiteName: name)!
+        defer { defaults.removePersistentDomain(forName: name) }
+        let original = PhonePreferences()
+        try PhonePreferencesStore(defaults: defaults).save(original)
+        let store = EyeAlignmentStore(defaults: defaults)
+        XCTAssertEqual(store.load(), EyeAlignment())
+        var profile = EyeAlignment(); profile.leftY = -0.03; profile.rightY = 0.09
+        try store.save(profile)
+        XCTAssertEqual(EyeAlignmentStore(defaults: defaults).load(), profile)
+        XCTAssertEqual(PhonePreferencesStore(defaults: defaults).load(), original)
+        defaults.set(Data("bad".utf8), forKey: EyeAlignmentStore.key)
+        XCTAssertEqual(store.load(), EyeAlignment())
+        try store.save(profile); store.reset()
+        XCTAssertEqual(store.load(), EyeAlignment())
+        XCTAssertEqual(PhonePreferencesStore(defaults: defaults).load(), original)
+    }
+    func testRejectsNonfiniteOrExcessiveCorrections() {
+        for value in [Double.nan, .infinity, -.infinity, 0.301, -0.301] {
+            var profile = EyeAlignment(); profile.rightY = value
+            XCTAssertThrowsError(try profile.validated())
+        }
+    }
+}
