diff --git a/experimental/steamvr/tests/test_driver_calibration.py b/experimental/steamvr/tests/test_driver_calibration.py
new file mode 100644
index 0000000..af0c635
--- /dev/null
+++ b/experimental/steamvr/tests/test_driver_calibration.py
@@ -0,0 +1,27 @@
+"""Validate the actual driver-supplied chaperone document and origin math."""
+import json
+from pathlib import Path
+import re
+import unittest
+
+
+class DriverCalibrationTests(unittest.TestCase):
+    def test_seated_origin_matches_fixed_virtual_head(self):
+        native = Path(__file__).resolve().parents[1] / 'native'
+        source = (native / 'calibration.hpp').read_text(encoding='utf-8')
+        document = json.loads(re.search(r'R"json\((.*?)\)json"', source, re.S)[1])
+        self.assertEqual(document['jsonid'], 'chaperone_info')
+        self.assertEqual(document['version'], 5)
+        self.assertEqual(len(document['universes']), 1)
+        universe = document['universes'][0]
+        self.assertEqual(int(universe['universeID']), 904040)
+        self.assertEqual(universe['standing'], {'translation': [0, 0, 0], 'yaw': 0})
+        self.assertEqual(universe['seated'], {'translation': [0, 1.6, 0], 'yaw': 0})
+        # The virtual raw head at [0,1.6,0] becomes the seated origin [0,0,0].
+        self.assertEqual([a-b for a, b in zip([0,1.6,0], universe['seated']['translation'])], [0,0,0])
+        self.assertEqual(universe['collision_bounds'], [])
+        self.assertEqual(universe['play_area'], [1, 1])
+
+
+if __name__ == '__main__':
+    unittest.main()
