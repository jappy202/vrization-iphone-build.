+void calibration_tests() {
+    struct Properties {
+        int calls=0;
+        std::string json;
+        vr::ETrackedPropertyError jsonError=vr::TrackedProp_Success;
+        vr::ETrackedPropertyError universeError=vr::TrackedProp_Success;
+        vr::ETrackedPropertyError SetStringProperty(vr::PropertyContainerHandle_t container,
+                vr::ETrackedDeviceProperty property,const char* value) {
+            require(container==77 && calls++==0,"calibration targets own HMD first");
+            require(property==vr::Prop_DriverProvidedChaperoneJson_String,"driver-provided JSON property");
+            json=value; return jsonError;
+        }
+        vr::ETrackedPropertyError SetUint64Property(vr::PropertyContainerHandle_t container,
+                vr::ETrackedDeviceProperty property,std::uint64_t value) {
+            require(container==77 && calls++==1,"select universe after supplying calibration");
+            require(property==vr::Prop_CurrentUniverseId_Uint64 && value==904040,"select only own universe");
