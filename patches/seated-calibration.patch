+        "seated calibration publication succeeds");
+    require(p.json==vrization::kPhoneChaperone,"publish complete calibration document");
+    Properties rejected; rejected.jsonError=vr::TrackedProp_UnknownProperty;
+    require(vrization::configure_phone_calibration(&rejected,77)==vr::TrackedProp_UnknownProperty && rejected.calls==1,
+        "failed calibration never selects an uninitialized universe");
+    Properties universeRejected;universeRejected.universeError=vr::TrackedProp_InvalidDevice;
+    require(vrization::configure_phone_calibration(&universeRejected,77)==vr::TrackedProp_InvalidDevice,
+        "universe property failure propagates");
+}
