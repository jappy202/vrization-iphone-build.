+// Original VRization seated-origin configuration, MIT.
+// Schema/API reference: Valve OpenVR 0924064316de3effbcd1acf1e309182a2deb1c05,
+// docs/Driver_API_Documentation.md, Chaperone (BSD-3-Clause SDK; see licenses).
+#pragma once
+#include <cstdint>
+#include <openvr_driver.h>
+
+namespace vrization {
+constexpr std::uint64_t kPhoneUniverse = 904040;
+// This virtual 3DOF driver fixes the head at y=1.6 m. The seated origin must
+// match that height; no physical tracking area or room-scale bounds are claimed.
+constexpr char kPhoneChaperone[] = R"json({
+  "jsonid": "chaperone_info",
+  "version": 5,
+  "time": "2026-10-28T00:00:00Z",
+  "universes": [{
+    "universeID": "904040",
+    "time": "2026-10-28T00:00:00Z",
+    "standing": {"translation": [0, 0, 0], "yaw": 0},
+    "seated": {"translation": [0, 1.6, 0], "yaw": 0},
+    "play_area": [1, 1],
+    "collision_bounds": []
+  }]
+})json";
+
+template<class Properties>
+vr::ETrackedPropertyError configure_phone_calibration(Properties* properties,
+        vr::PropertyContainerHandle_t container) {
+    // Supply the calibration before selecting this universe. This property is
+    // on our own HMD container; no global chaperone file or other device changes.
+    const auto error=properties->SetStringProperty(container,
+        vr::Prop_DriverProvidedChaperoneJson_String,kPhoneChaperone);
+    if(error!=vr::TrackedProp_Success) return error;
+    return properties->SetUint64Property(container,
+        vr::Prop_CurrentUniverseId_Uint64,kPhoneUniverse);
+}
+}
